# Production configuration for docker-compose.prod.yml.
#
#   cp .env.example .env      # then edit, on the SERVER
#
# .env is gitignored — never commit a filled-in copy. Nothing here is secret
# today (no API keys, no passwords), but that changes the moment you add one.

# ─── Required ────────────────────────────────────────────────────────────────

# Bare domain, no scheme and no trailing slash. Caddy serves this and www.<it>,
# and obtains a certificate for both, so DNS A records must already point here.
SAR_DOMAIN=example.com

# Where Let's Encrypt sends expiry warnings. A real address you read.
SAR_ACME_EMAIL=you@example.com


# ─── Images ──────────────────────────────────────────────────────────────────

# Which published images to run. Lowercase owner/repo, as GHCR stores it.
GITHUB_REPOSITORY=kadircankara/multi-uav-sar

# 'latest' follows main. Pin to a commit SHA for a reproducible deploy, and to
# make rollback a one-line edit:  SAR_IMAGE_TAG=<sha>
SAR_IMAGE_TAG=latest


# ─── Data ────────────────────────────────────────────────────────────────────

# Host path holding the unpacked Results/ tree (Objectives, Solutions,
# Metadata). Must be WRITABLE by uid 1000 — the app writes temp run dirs under
# Results/.runs. scripts/bootstrap-box.sh creates it correctly.
SAR_DATA_DIR=/opt/sar/Results


# ─── Memory ──────────────────────────────────────────────────────────────────
# These two decide whether the box survives its worst moment. Measured: one
# large scenario costs ~160 MB cached, one optimizer child 180-500 MB.

# Scenarios kept unpickled in memory. 6 x ~160 MB ≈ 1 GB worst case.
# On a 2 GB box use 3. On 8 GB you can raise it for fewer cold loads.
SAR_SELECTOR_CACHE_SIZE=6

# Concurrent optimizer runs. Each pins ~100% of one core, so keep this at or
# below (cores - 1) or replays starve while an optimization runs.
SAR_OPTIMIZE_WORKERS=2

# Hard ceiling for the backend container. Exceeding it restarts the container
# rather than letting the kernel OOM-kill something at random. Budget roughly:
#   140 MB base + (cache size x 160 MB) + (workers x 500 MB) + headroom
SAR_BACKEND_MEMORY_LIMIT=2600m


# ─── Queue ───────────────────────────────────────────────────────────────────

# Total runs held at once (running + waiting). Beyond this the API returns 409.
SAR_OPTIMIZE_QUEUE_MAX=8

# Slots any single client (IP) may hold. 1 on a public deploy: one visitor
# should never be able to occupy the whole pool for the length of a long run.
SAR_OPTIMIZE_MAX_PER_CLIENT=1

# Temp per-run dirs live under Results/.runs. The newest RUN_KEEP are retained
# (so a recent run can still be exported); older ones are swept on a timer —
# every PURGE_INTERVAL seconds, regardless of whether new runs are starting — so
# the volume stays bounded even when the app goes quiet. This is what stops a day
# of demoing from filling the disk. 0 interval disables the timer sweep.
SAR_OPTIMIZE_RUN_KEEP=40
SAR_RUN_PURGE_INTERVAL_SECONDS=900


# ─── Per-run cost caps ───────────────────────────────────────────────────────
# These bound how long one run can hold a worker, and so how long everyone
# queued behind it waits. n_visits is the largest multiplier reachable from a
# request — uncapped it made a single run exceed a week of CPU.

SAR_MAX_N_VISITS=3

# Sized for CONVERGENCE, not latency: with the constraints active, runs much
# smaller than this frequently fail to converge, so trimming them to shorten
# the worst case just produces fast, useless fronts.
SAR_MAX_POP_SIZE=300
SAR_MAX_N_GEN=1000


# ─── Rate limits ─────────────────────────────────────────────────────────────
# Per client IP. slowapi syntax: "30/minute", "500/hour".

SAR_OPTIMIZE_RATE_LIMIT=30/minute
SAR_REPLAY_RATE_LIMIT=60/minute

# The two comparison endpoints fan one request out to up to 360 / 144 heavy
# per-scenario operations, so they get a tighter per-IP budget of their own...
SAR_COMPARISON_RATE_LIMIT=10/minute

# ...and a server-wide ceiling on how many run at once. On a 2-core box keep this
# at 1-2 so parallel comparisons cannot take every core; excess requests get a
# fast 503 instead of piling CPU-bound work behind the ones already running.
SAR_COMPARISON_CONCURRENCY=2


# ─── Logging ─────────────────────────────────────────────────────────────────

# Root log level. INFO logs run lifecycle (queued / finished / failed) and any
# unhandled 500; DEBUG is noisier. Container logs are captured by Docker (see the
# json-file driver in docker-compose.prod.yml) and readable via `docker logs`.
SAR_LOG_LEVEL=INFO


# ─── Proxy ───────────────────────────────────────────────────────────────────

# Which peers uvicorn trusts X-Forwarded-For from. The default covers Docker's
# bridge networks, i.e. Caddy. NEVER set this to '*' on a public host — that
# lets any client spoof its IP and walk straight through the rate limits and
# the per-client queue cap.
FORWARDED_ALLOW_IPS=172.16.0.0/12
