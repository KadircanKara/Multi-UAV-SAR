# Multi-UAV SAR site block for the VM's shared edge Caddy (the ResearcherX demo
# Caddy, which imports every /srv/edge/sites/*.caddy). Install as root:
#
#   cp multiuavsar.caddy /srv/edge/sites/
#   docker exec researcherx-demo-caddy-1 caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   docker exec researcherx-demo-caddy-1 caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
#
# Upstreams are this app's aliases on the external `proxy` network
# (docker-compose.prod.yml), unique on the VM.
multiuavsar.kadircankara.dev {
	encode zstd gzip

	request_body {
		max_size 10MiB
	}

	handle /api/* {
		reverse_proxy sar-backend:8000 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy sar-web:3000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}
}
