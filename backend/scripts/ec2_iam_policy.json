{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3BatchResults",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::multi-uav-sar-results",
        "arn:aws:s3:::multi-uav-sar-results/*"
      ]
    },
    {
      "Sid": "SelfTerminate",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/SARBatch": "true"
        }
      }
    }
  ]
}
